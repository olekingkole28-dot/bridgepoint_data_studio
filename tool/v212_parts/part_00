from pathlib import Path
import sys

p=Path(sys.argv[1] if len(sys.argv)>1 else 'lib/main.dart')
s=p.read_text()

def once(old,new,label):
    global s
    if old not in s:
        raise SystemExit(f'MISSING {label}')
    if s.count(old)!=1:
        raise SystemExit(f'NONUNIQUE {label}: {s.count(old)}')
    s=s.replace(old,new,1)

def replace_block(start_marker,end_marker,new,label):
    global s
    a=s.find(start_marker)
    if a<0: raise SystemExit(f'MISSING start {label}')
    b=s.find(end_marker,a)
    if b<0: raise SystemExit(f'MISSING end {label}')
    s=s[:a]+new+s[b:]

def class_range(name):
    a=s.find('class '+name)
    if a<0: raise SystemExit('missing class '+name)
    j=s.find('{',a); d=0
    for k in range(j,len(s)):
        if s[k]=='{':d+=1
        elif s[k]=='}':
            d-=1
            if d==0:return a,k+1
    raise SystemExit('unclosed '+name)

def replace_class(name,new):
    global s
    a,b=class_range(name);s=s[:a]+new+s[b:]

