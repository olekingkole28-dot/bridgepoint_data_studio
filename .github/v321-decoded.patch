+String _formatExpansionEtaV321(dynamic raw){
+  if(raw is! Map)return 'Status updating';
+  final eta=Map<String,dynamic>.from(raw);
+  final status='${eta['eta_status']??''}'.toUpperCase();
+  if(status=='COMPLETE')return 'Live';
+  if(status=='QUEUED')return '${eta['eta_label']??'Queued'}';
+  if(status=='CALCULATING')return 'Calculating from live throughput';
+  final seconds=(eta['seconds_remaining'] as num?)?.toDouble();
+  if(seconds==null||seconds<0)return '${eta['eta_label']??'Status updating'}';
+  final hours=seconds/3600;
+  if(hours<1)return '${(seconds/60).ceil()} min remaining';
+  if(hours<48)return '${hours.toStringAsFixed(hours<10?1:0)} hr remaining';
+  final days=hours/24;
+  return '${days.toStringAsFixed(days<10?1:0)} days remaining';
+}
+Color _expansionEtaColorV321(dynamic raw){
+  if(raw is! Map)return AppTheme.textMuted;
+  final s='${raw['eta_status']??''}'.toUpperCase();
+  if(s=='COMPLETE')return AppTheme.green;if(s=='ESTIMATED')return AppTheme.cyan;if(s=='QUEUED')return AppTheme.blue;if(s=='CALCULATING')return AppTheme.amber;return AppTheme.textMuted;
+}
