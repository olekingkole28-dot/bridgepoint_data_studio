{
  "version": 2500,
  "replacement_target": "existing Intelligence Map tab",
  "defaults": {
    "radar": true,
    "property_circles": false,
    "physical_weather_fx": false,
    "toolbar_hidden": true,
    "start_at_user_location_when_permitted": true,
    "continuous_us_zoom": true
  },
  "required_runtime_contracts": [
    "bridgepoint_3d_world_viewport_v1899",
    "bridgepoint_building_detail_v2300",
    "bridgepoint_flutter_property_detail_v344",
    "bridgepoint_live_map_weather_scene_v1997",
    "BridgePointWorldV2500",
    "USGSImageryOnly",
    "weather.gov"
  ],
  "optional_enrichment_contracts": [
    "bridgepoint_property_timeline_v857",
    "bridgepoint_property_climate_profile_v510",
    "bridgepoint_digital_twin_summary_v856",
    "bridgepoint_property_geometry_v854",
    "bridgepoint_flutter_permit_context_v68",
    "bridgepoint_property_media_bundle_v169"
  ],
  "forbidden_runtime_strings": [
    "tile.googleapis.com",
    "googleMapsTileKey",
    "createWorldTerrainAsync",
    "Cesium.Ion",
    "cesiumIonToken",
    "api.mapbox.com",
    "mapboxgl",
    "virtualearth.net",
    "bing.com/maps",
    "nearmap",
    "openfreemap",
    "tile.openstreetmap.org"
  ],
  "public_sources": [
    "USGS National Map imagery",
    "USGS 3DEP elevations already ingested by BridgePoint",
    "NOAA/NWS radar and alerts",
    "NOAA/NHC tropical cyclone GIS through BridgePoint/public feeds",
    "NIFC/WFIGS wildfire geometry through BridgePoint/public feeds"
  ],
  "truth_rules": [
    "Never synthesize exact parcel, roof, road, rail, terrain or hazard geometry.",
    "Never label forecast/alert context as observed property damage.",
    "Keep partial building-card truth visible if enrichment times out.",
    "Selection may add glow/outline but must retain intelligence color.",
    "Weather refresh may not reset camera or selected structure."
  ],
  "historical_regressions_blocked": [
    "state/county controls covering zoom controls",
    "county card swarm",
    "map gestures scrolling parent page",
    "camera snapping or zoom reset",
    "three-second scene refresh jolt",
    "building detail card blanking on timeout",
    "weather hiding buildings/parcels/roads",
    "fake point weather instead of source geometry",
    "multiple competing map canvases"
  ]
}
